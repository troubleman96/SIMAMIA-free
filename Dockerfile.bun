FROM oven/bun:1 AS builder
WORKDIR /app
COPY package.json bun.lock ./
COPY landing/package.json ./landing/package.json
RUN bun install --frozen-lockfile
COPY . .
ARG NEXT_PUBLIC_CAMEL_ACCOUNTS_URL=https://accounts.camelcreatives.com
ARG NEXT_PUBLIC_CAMEL_ACCOUNTS_CLIENT_ID=simamia-35sj96
ARG NEXT_PUBLIC_SIMAMIA_API_URL=https://api.simamia.online/api/v1
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG NEXT_PUBLIC_SENTRY_DISABLED=false
ENV NEXT_PUBLIC_CAMEL_ACCOUNTS_URL=$NEXT_PUBLIC_CAMEL_ACCOUNTS_URL
ENV NEXT_PUBLIC_CAMEL_ACCOUNTS_CLIENT_ID=$NEXT_PUBLIC_CAMEL_ACCOUNTS_CLIENT_ID
ENV NEXT_PUBLIC_SIMAMIA_API_URL=$NEXT_PUBLIC_SIMAMIA_API_URL
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_DISABLED=$NEXT_PUBLIC_SENTRY_DISABLED
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

FROM nginx:1.30.5-alpine3.24
COPY deploy/app-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out/ /usr/share/nginx/html/
EXPOSE 80
